{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Screenshotr",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "identifier": "ca.aahmed.screenshotr",
      "targets": "all",
      "icon": [
        "icons/icon.icns",
        "icons/icon.png"
      ],
      "macOS": {
        "minimumSystemVersion": "13.0"
      }
    },
    "windows": [],
    "systemTray": {
      "iconPath": "icons/tray/idle.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/asharahmed/screenshotr/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNkM2MjAxRjJCMDc2RTcKUldUbmRyRHlBV0pza3ZUS2Q4SzdWOWxUVGs2RndmcTVGVys3WjlsUXBrS0NBekJFNEUrTXlxclYK"
    }
  }
}
