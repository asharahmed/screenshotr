# Settings for scripts/release.sh. Nothing here is secret.

# Where releases are published: owner/repository on GitHub.
GITHUB_REPO=asharahmed/screenshotr
# Your Homebrew tap (a GitHub repository named homebrew-<something>), for the cask.
TAP_REPO=asharahmed/homebrew-tap
# The Developer ID certificate in your keychain.
SIGNING_IDENTITY="Developer ID Application: Ashar Ahmed (AXZA9Y8669)"
# A notarytool keychain profile, created once with:
#   xcrun notarytool store-credentials AC_PROFILE --apple-id <you> --team-id AXZA9Y8669
NOTARY_PROFILE=AC_PROFILE
# The updater signing key made by `cargo tauri signer generate`. Keep a backup: every update
# must be signed with it, and a new key would strand existing installs.
UPDATER_KEY="$HOME/.tauri/screenshotr.key"
